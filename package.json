  "description": "A Mario-style game in the VS Code.",
  "version": "0.0.1",
  "license": "MIT",
  "author": {
    "name": "Pabasara Mahindapala",
    "url": "https://github.com/pabasara-mahindapala"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pabasara-mahindapala/vscode-mario.git"
  },
  "bugs": {
    "url": "https://github.com/pabasara-mahindapala/vscode-mario/issues"
